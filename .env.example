# Use your Ubuntu host's LAN IPv4 address when testing on a physical phone.
# Example: http://192.168.1.100:8788/api
# Android emulator can usually use http://10.0.2.2:8788/api instead.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8788/api
# Local testing only. Must match API_ACCESS_KEY in propertyhub-uganda/.env.
# Do not use a shared API key as production mobile authentication.
EXPO_PUBLIC_API_KEY=replace-with-a-long-random-key
